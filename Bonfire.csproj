<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Bonfire</AssemblyName>
    <Product>A mod that adds various difficulty settings to enable.</Product>
    <Version>0.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>Bonfire</RootNamespace>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Iron Nest Heavy Turret Simulator</GameDir>
    <OutputPath>$(GameDir)\MLLoader\Mods\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
  <Reference Include="$(GameDir)\MLLoader\MelonLoader\MelonLoader.dll">
    <Private>false</Private>
  </Reference>
  <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll">
    <Private>false</Private>
  </Reference>
  <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll">
    <Private>false</Private>
  </Reference>
  <Reference Include="$(GameDir)\MLLoader\MelonLoader\Il2CppAssemblies\*.dll">
    <Private>false</Private>
  </Reference>
  </ItemGroup>
</Project>
